---
layout: layouts/base.njk
eleventyNavigation:
  key: Home
  order: 1
---

<div class="px-6 pt-2">
  {% include 'settings.njk' %}
  <div class="max-w-4xl mx-auto py-10">
    <div class="term-window">
      <div class="term-titlebar">
        <span class="term-dot bg-term-red"></span>
        <span class="term-dot bg-term-yellow"></span>
        <span class="term-dot bg-term-green"></span>
        <span class="ml-3 text-xs text-term-muted">guest@pythonexpert:~</span>
      </div>
      <div class="p-6 font-victor-mono">
        <p class="text-term-green text-sm mb-1">$ whoami</p>
        <h2 class="text-xl md:text-2xl text-term-text mb-6">PythonExpert 🚀</h2>
        <p class="mb-4 text-term-muted">
          <span class="text-term-muted">#</span>
          PythonExpert is a
          <strong class="text-term-text">free</strong>
          and
          <strong class="text-term-text">open-source</strong>
          web application built to help anyone learn how to program, step by step.
        </p>
        <p class="text-term-muted">
          <span class="text-term-green">$</span> ls ./courses
        </p>
      </div>
    </div>
  </div>
  <div class="max-w-4xl mx-auto py-10">
    <div class="grid md:grid-cols-3 gap-6">
      {% for course in collections.course|filter("hidden", undefined)|sort("order") %}
        <div class="relative group mb-4 border border-term-border bg-term-surface p-4 hover:border-term-accent transition">
          <p class="text-xs text-term-muted mb-2">
            <span class="text-term-green">&gt;</span> ./{{ course.data.title | lower | replace(" ", "-") }}
          </p>
          <h4 class="mb-2 text-term-text font-semibold">{{ course.data.title }}</h4>
          {% if course.data.is_under_development %}
            <div class="text-xs mb-4 border border-term-yellow text-term-yellow px-2 inline-block">
              Under development
            </div>
          {% endif %}
          <p class="text-term-muted mb-4 text-sm">{{ course.data.description }}</p>
          <a href="{{ course.url }}" class="text-sm text-term-accent hover:underline stretched-link">$ start_learning --now</a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
