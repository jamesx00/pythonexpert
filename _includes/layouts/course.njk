---
layout: layouts/base.njk
---

<div class="border-b border-term-border px-6">
    <div class="max-w-4xl mx-auto py-16">
        <p class="mb-4 text-sm text-term-muted">
            <a href="{{ '/' | url }}" class="text-term-accent hover:underline">$ cd ~</a>
        </p>
        <div class="term-window mb-16">
            <div class="term-titlebar">
                <span class="term-dot bg-term-red"></span>
                <span class="term-dot bg-term-yellow"></span>
                <span class="term-dot bg-term-green"></span>
                <span class="ml-3 text-xs text-term-muted">~/courses/{{ course_id or title | lower }}</span>
            </div>
            <div class="p-6 font-victor-mono prose prose-invert prose-headings:text-primary-800 max-w-none">
                <h1 class="text-xl md:text-2xl">{{ title }}</h1>
                {% if is_under_development %}
                    <div class="mb-4">
                        <span class="text-sm text-term-red">This course is under development. We will be adding more lessons regularly.</span>
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="font-victor-mono">
            <p class="text-sm text-term-green mb-4">$ ls -la ./lessons</p>
            <ul>
                {% for lesson in collections.lesson|filter("course_id", course_id)|sortByDirectoryPrefix %}
                    <li>
                        {% if lesson.data.section %}
                            <p class="font-bold mt-4 text-primary-700 mb-4"><span class="text-term-muted">#</span> {{ lesson.data.section }}</p>
                        {% endif %}
                        <div class="flex items-center mb-2" x-data="{completed: $persist(false).as('{{ lesson.url }}')}">
                            <i
                                x-cloak
                                x-show="completed"
                                @click="completed=false"
                                class="mr-2 fal fa-fw fa-check-circle hover:cursor-pointer text-term-green"></i>
                            <i x-cloak x-show="!completed" @click="completed=true" class="mr-2 fal fa-fw fa-circle hover:cursor-pointer text-term-muted"></i>
                            <a href="{{ lesson.url }}" class="text-term-text hover:text-term-accent hover:underline">
                                {{ lesson.data.lesson_name }}
                            </a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
