<script type="application/json" id="command-palette-data">{% commandPaletteData collections %}</script>
<div
    x-data="commandPalette()"
    @toggle-command-palette.window="toggle()"
    @open-command-palette.window="show()"
    @keydown.escape.window="hide()"
    x-cloak
    x-show="open"
    class="fixed inset-0 z-50"
    role="dialog"
    aria-modal="true"
    aria-label="Command palette">
    <div class="fixed inset-0 bg-black/70" x-transition.opacity @click="hide()"></div>
    <div class="fixed inset-0 z-10 overflow-y-auto p-4 sm:p-6 md:p-20">
        <div
            class="mx-auto max-w-2xl border border-term-border bg-term-surface font-victor-mono shadow-2xl"
            x-transition:enter="ease-out duration-150"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            @click.outside="hide()">
            <div class="flex items-center border-b border-term-border px-4">
                <span class="mr-2 text-term-green">$</span>
                <input
                    x-ref="searchInput"
                    type="text"
                    x-model="query"
                    @input="activeIndex = 0"
                    @keydown.down.prevent="move(1)"
                    @keydown.up.prevent="move(-1)"
                    @keydown.enter.prevent="selectActive()"
                    placeholder="Search courses, lessons, blog posts..."
                    autocomplete="off"
                    spellcheck="false"
                    class="w-full border-0 bg-transparent py-4 text-sm text-term-text placeholder:text-term-muted focus:outline-none focus:ring-0"/>
                <kbd class="border border-term-border px-1.5 py-0.5 text-xs text-term-muted">esc</kbd>
            </div>
            <div x-ref="resultsList" class="max-h-96 overflow-y-auto py-2">
                <template x-if="filteredItems.length === 0">
                    <p class="px-4 py-8 text-center text-sm text-term-muted">No results found.</p>
                </template>
                <template x-for="group in groupedItems" :key="group.category">
                    <div class="mb-2 last:mb-0">
                        <p class="px-4 pb-1 pt-2 text-xs uppercase tracking-wide text-term-muted">
                            <span class="text-term-green">#</span> <span x-text="group.category"></span>
                        </p>
                        <template x-for="item in group.items" :key="item.category + item.url">
                            <a
                                :href="item.url"
                                @mouseenter="activeIndex = item.index"
                                :data-active="item.index === activeIndex"
                                :class="item.index === activeIndex ? 'bg-term-raised text-term-accent' : 'text-term-text'"
                                class="flex items-center justify-between gap-4 px-4 py-2 text-sm hover:bg-term-raised hover:text-term-accent">
                                <span x-text="item.title"></span>
                                <span x-show="item.subtitle" x-text="item.subtitle" class="shrink-0 text-xs text-term-muted"></span>
                            </a>
                        </template>
                    </div>
                </template>
            </div>
            <div class="flex items-center gap-4 border-t border-term-border px-4 py-2 text-xs text-term-muted">
                <span><kbd class="border border-term-border px-1">&uarr;</kbd><kbd class="ml-1 border border-term-border px-1">&darr;</kbd> navigate</span>
                <span><kbd class="border border-term-border px-1">&crarr;</kbd> select</span>
                <span><kbd class="border border-term-border px-1">esc</kbd> close</span>
            </div>
        </div>
    </div>
</div>
