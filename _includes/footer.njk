<footer class="border-t border-term-border bg-term-surface font-victor-mono">
    <div class="default-container md:flex px-4 py-4 text-term-muted">
        <div class="md:flex md:gap-8 lg:gap-16">
            <p class="text-sm text-term-green mb-2 md:mb-0 md:mr-4 shrink-0">$ ls ~/site</p>
            <ul
                class="flex flex-wrap gap-4">
                {% for item in collections.all | eleventyNavigation %}
                    <li class="text-sm hover:text-term-accent hover:underline">
                        <a class="" href="{{ item.url }}">{{ item.key | lower }}</a>
                    </li>
                {% endfor %}
                <li class="text-sm hover:text-term-accent hover:underline">
                    <a class="" href="/markdown-editor/">live-editor</a>
                </li>
                <li class="text-sm hover:text-term-accent hover:underline">
                    <a class="" href="/diff-editor/">diff-editor</a>
                </li>
                <li class="text-sm hover:text-term-accent hover:underline">
                    <a class="" href="/code-execution/">run-your-code</a>
                </li>
                <li class="text-sm hover:text-term-accent hover:underline">
                    <a class="" href="/runtimes/">check-runtimes</a>
                </li>
            </ul>
            {# <ul class="mb-6">
                <li class="mb-2">
                    <span class="text-primary-800">Contact</span>
                </li>
                <li class="">
                    <a class="text-sm hover:underline" href="mailto:{{ metadata.author.email }}">✉️ send me an email</a>
                </li>
            </ul> #}
        </div>
    </div>
</footer>